<h1>Meeting Notes<br>to Action Tracker</h1>
<p>Turn agreed next steps into action rows with owners, deadlines, and the excerpt that supports each action.</p>
<section class="grid" aria-label="Interactive replay">
<div class="panel"><h2>Meeting notes</h2><label for="meeting">Choose a meeting</label><select id="meeting"></select><p id="notes"></p><button id="run">Extract actions</button><p><small>This replay uses predefined extraction responses.</small></p></div>
<div class="panel"><h2>Action tracker</h2><div id="result" aria-live="polite"></div></div>
</section>
<section><h2>How it works</h2><p>Make reads new meeting notes from Google Sheets. OpenAI extracts the next steps. A validation step checks the source excerpts and flags missing owners or deadlines before Make adds the actions to the tracker.</p><a href="https://github.com/emmjaymedia/a-majid-portfolio/tree/master/automation/meeting-action-tracker">View workflow source and setup</a></section>
</main>
<script>
function validate(input) {
/* CODE */
}
const cases = /* CASES */;
const meeting = document.querySelector('#meeting');
const result = document.querySelector('#result');
for (const item of cases) meeting.add(new Option(item.title));
function renderNotes() {
 document.querySelector('#notes').textContent = cases[meeting.selectedIndex].notes;
 result.textContent = 'Run the replay to see the action rows.';
}
meeting.addEventListener('change', renderNotes);
renderNotes();
document.querySelector('#run').addEventListener('click', () => {
 const item = cases[meeting.selectedIndex];
 const {rows} = validate({meeting_id:item.id, notes:item.notes, model_response:JSON.stringify({actions:item.actions})});
 if (!rows.length) { result.textContent = 'No agreed actions to track.'; return; }
 const cards = rows.map(row => {
  const card = document.createElement('article');
  const heading = document.createElement('h3');
  heading.textContent = row.action;
  card.append(heading);
  for (const text of [row.status + (row.missing ? ' · Missing ' + row.missing.toLowerCase() : ''), 'Owner: ' + (row.owner || 'Unassigned') + ' · Due: ' + (row.due || 'Unspecified'), 'From the notes: “' + row.evidence + '”']) {
   const p = document.createElement('p');
   p.textContent = text;
   card.append(p);
  }
  return card;
 });
 result.replaceChildren(...cards);
});
</script>

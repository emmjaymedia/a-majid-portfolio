*{box-sizing:border-box}body{margin:0;background:#f5f4ee;color:#172b2a;font:16px/1.55 system-ui,sans-serif}main{max-width:1060px;margin:auto;padding:3rem 1.5rem}a{color:#16453b}h1{font-size:clamp(2.7rem,7vw,5.2rem);letter-spacing:-.065em;line-height:1;margin:.5rem 0 1rem}h2{line-height:1.2}.eyebrow{color:#315f56;font-weight:750}section{margin-top:2rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:1rem}.panel{background:white;border:1px solid #d8e1dc;border-radius:16px;padding:1.25rem}label,dt{font-weight:750}select,button{font:inherit;padding:.6rem .8rem;border-radius:8px}select{width:100%;background:white;border:1px solid #82938c;margin:.4rem 0}button{background:#16453b;color:white;border:0;cursor:pointer}:focus-visible{outline:3px solid #ac5816;outline-offset:3px}dd{margin:0 0 .6rem;white-space:pre-wrap}small{color:#39564e}

<main>
<a href="/#automation">Back to workflow projects</a>
<p class="eyebrow">Workflow automation · Abdulmajid Abdurrahim</p>
<h1>Client Enquiry<br>to Sales Pipeline</h1>
<p>Turn website enquiries into structured leads and prepare follow-up drafts for review.</p>
<section class="grid" aria-label="Interactive replay">
<div class="panel"><h2>Incoming enquiry</h2><label for="enquiry">Choose an enquiry</label><select id="enquiry"></select><p id="message"></p><p id="details"></p><button id="run">Prepare lead</button><p><small>This replay uses predefined classifier responses.</small></p></div>
<div class="panel"><h2>Lead record</h2><div id="result" aria-live="polite"></div></div>
</section>
<section>
<h2>How it works</h2>
<ol><li>Zapier Forms captures an enquiry in Zapier Tables.</li><li>OpenAI classifies the service request, summarizes it, and drafts a reply.</li><li>Zapier checks for missing budget and timeline details and updates the original lead for review.</li></ol>
<a href="https://github.com/emmjaymedia/a-majid-portfolio/tree/master/automation/client-enquiry-pipeline">View workflow source and setup</a>
</section>
</main>
<script>
/* NORMALIZE */
const cases = /* CASES */;
const input = document.querySelector('#enquiry');
const result = document.querySelector('#result');
for (const enquiry of cases) input.add(new Option(enquiry.company));
function renderEnquiry() {
 const item = cases[input.selectedIndex];
 document.querySelector('#message').textContent = item.message;
 document.querySelector('#details').textContent = 'Budget: ' + (item.budget || 'Unspecified') + ' · Timeline: ' + (item.timeline || 'Unspecified');
 result.textContent = 'Choose an enquiry and prepare the lead.';
}
input.addEventListener('change', renderEnquiry);
renderEnquiry();
document.querySelector('#run').addEventListener('click', () => {
 const item = cases[input.selectedIndex];
 const lead = normalizeEnquiry(item, JSON.stringify(item.model));
 const list = document.createElement('dl');
 for (const [label, value] of [['Service',lead.service_category], ['Summary',lead.lead_summary], ['Missing details',lead.missing_details || 'None'], ['Status',lead.lead_status], ['Follow-up draft',lead.follow_up_draft]]) {
  const term = document.createElement('dt');
  const description = document.createElement('dd');
  term.textContent = label;
  description.textContent = value;
  list.append(term, description);
 }
 result.replaceChildren(list);
});
</script>
